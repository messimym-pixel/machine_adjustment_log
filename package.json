{
  "name": "machine-adjustment-log-system",
  "version": "1.0.0",
  "private": true,
  "description": "Factory Machine Adjustment Tracking System (Offline Ready + SQLite + PM2)",
  "scripts": {
    "build": "cd src && npm run build",
    "start": "node server/server.js",
    "pm2:start": "npx pm2 start ecosystem.config.cjs",
    "pm2:stop": "npx pm2 stop ecosystem.config.cjs",
    "pm2:restart": "npx pm2 restart ecosystem.config.cjs",
    "pm2:status": "npx pm2 status",
    "pm2:logs": "npx pm2 logs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "pm2": "^5.4.3"
  }
}
