# Backend environment variables
# Copy this file to .env and fill in the values

# PostgreSQL connection string from Neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Server port (Render sets this automatically, no need to change)
PORT=3001

# Node environment
NODE_ENV=production
